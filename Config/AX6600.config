# 京东云雅典娜 AX6600 = JDCloud RE-CS-02 / IPQ6010
# 目标：qualcommax / ipq60xx / DEVICE_jdcloud_re-cs-02
# 集成：NaiLink(daed-router) + clashoo + luci-theme-vantage + nikki

# ---------- target ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ---------- 内核：eBPF ----------
# 注意：RE-CS-02 的 kernel 分区被写死 6144k（ipq60xx.mk 的 KERNEL_SIZE），
# 打开 DEBUG_INFO_BTF 后 FIT 内核实测 7677924B，超限 1.38MB 直接不生成 sysupgrade.bin。
# 因此默认关闭 BTF，daed 内核不可用（NaiLink 仍可切 sing-box / mihomo 内核）。
# 要 daed：workflow 里传 with_btf=true，脚本会把 KERNEL_SIZE 补到 8192k 再编。
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_INFO_BTF=n
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_SPLIT=n
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_BPF_JIT_ALWAYS_ON=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NET_CLS_BPF=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_NET_SCH_INGRESS=y
CONFIG_KERNEL_NET_SCH_BPF=y
CONFIG_KERNEL_VETH=y
CONFIG_KERNEL_TUN=y
CONFIG_KERNEL_NF_TABLES=y
CONFIG_KERNEL_NFT_TPROXY=y
CONFIG_KERNEL_NFT_SOCKET=y
CONFIG_KERNEL_INET_DIAG=y

# ---------- 内核模块 + 运行依赖 ----------
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---------- 基础 LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- 1) NaiLink（slobys/NaiLink）----------
CONFIG_PACKAGE_daed-router=y
CONFIG_PACKAGE_luci-app-daed-router=y

# ---------- 2) clashoo（kenzok8/openwrt-clashoo）----------
CONFIG_PACKAGE_clashoo=y
CONFIG_PACKAGE_luci-app-clashoo=y

# ---------- 3) Vantage 主题（anothaDev/luci-theme-vantage）----------
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ---------- 4) nikki（nikkinikki-org/OpenWrt-nikki）----------
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
